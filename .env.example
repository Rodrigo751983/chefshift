# Database
DATABASE_URL="postgresql://chefshift:chefshift_password@localhost:5432/chefshift?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production"

# Stripe (paiements)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Cron (rappels automatiques, appel externe toutes les 15 min)
CRON_SECRET="change-this-cron-secret"

# Email (Resend)
RESEND_API_KEY="re_yourResendApiKey"
# Adresse d'expédition des emails transactionnels (doit être un domaine vérifié dans Resend)
EMAIL_FROM="ChefShift <info@chefshift.nl>"
# Adresse de contact affichée publiquement (Contact / Get in touch)
NEXT_PUBLIC_CONTACT_EMAIL="info@chefshift.nl"

# Redis (for Bull queue)
REDIS_URL="redis://localhost:6379"

# App
APP_URL="http://localhost:3000"

# Cloudflare Turnstile (captcha anti-bots sur /register)
# Site key : publique, lue par le navigateur
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAAAAA_site_key_ici"
# Secret : serveur uniquement. Sans elle le captcha est desactive (dev local).
TURNSTILE_SECRET_KEY="0x4AAAAAAA_secret_key_ici"

# API KVK (verification d'existence reelle d'un KvK-nummer) - produit payant.
# Sans cle, verifierKvkExistence() renvoie simplement 'non_verifie'.
KVK_API_KEY=""
